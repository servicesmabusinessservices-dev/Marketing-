{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GoogleAuth": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
    "RedirectUri": "https://your-api.example.com/api/v1/auth/google-callback"
  },
  "Jwt": {
    "Secret": "YourSuperSecretKeyMinimum32Characters!",
    "Issuer": "GmailManager",
    "Audience": "GmailManagerClient",
    "ExpiryHours": 1
  },
  "Cors": {
    "AllowedOrigins": ["https://your-frontend.example.com"]
  },
  "ConnectionStrings": {
    "MySql": "Server=your-host;Port=3306;Database=your_db;User=your_user;Password=CHANGE_ME;SslMode=Required;",
    "Redis": "your-redis-host:6379"
  }
}
