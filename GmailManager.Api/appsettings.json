{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GoogleAuth": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "https://marketing-1um3.onrender.com/api/auth/google-callback"
  },
  "FrontendUrl": "https://marketing-1um3.onrender.com",
  "Jwt": {
    "Secret": "",
    "Issuer": "GmailManager",
    "Audience": "GmailManagerClient"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "https://localhost:5001", "https://marketing-1um3.onrender.com"]
  },
  "ConnectionStrings": {
    "MySql": "",
    "Redis": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" } },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "RateLimiting": {
    "GlobalPermitLimit": 200,
    "GlobalWindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "EmailSendPermitLimit": 20,
    "EmailSendWindowSeconds": 60
  }
}
