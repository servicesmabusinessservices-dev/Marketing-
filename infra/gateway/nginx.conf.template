# ── API Gateway (NGINX) ──────────────────────────────────────────────────────
# Routes all /api/* traffic to the correct backend microservice.
# Production: set upstream URLs via env vars + envsubst.
# Local dev:  docker-compose sets the service hostnames directly.
upstream auth_upstream {
    server ${AUTH_SERVICE_URL};
}
upstream email_upstream {
    server ${EMAIL_SERVICE_URL};
}
upstream marketing_upstream {
    server ${MARKETING_SERVICE_URL};
}
upstream notification_upstream {
    server ${NOTIFICATION_SERVICE_URL};
}
upstream analytics_upstream {
    server ${ANALYTICS_SERVICE_URL};
}

server {
    listen 80;
    server_name _;

    # ── Global Security Headers ─────────────────────────────
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://marketing-api-38a1.onrender.com; frame-ancestors 'none';" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    location /health {
        access_log off;
        return 200 '{"status":"healthy"}';
        add_header Content-Type application/json;
    }

    # ── Auth routes ──────────────────────────────────────────────
    location /api/v1/auth/ {
        proxy_pass http://auth_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Email routes ─────────────────────────────────────────────
    location /api/v1/email/ {
        proxy_pass http://email_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Marketing routes ─────────────────────────────────────────
    location /api/v1/marketing/ {
        proxy_pass http://marketing_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Notification routes ──────────────────────────────────────
    location /api/v1/notifications/ {
        proxy_pass http://notification_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Analytics routes ─────────────────────────────────────────
    location /api/v1/analytics/ {
        proxy_pass http://analytics_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Catch-all: API Gateway itself (for the monolith fallback) ─
    location /api/ {
        proxy_pass http://auth_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
